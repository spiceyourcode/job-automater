# Copy to .env and fill in values. Never commit .env.

# Database (docker-compose postgres)
DATABASE_URL=postgresql://jobautomater:jobautomater@127.0.0.1:5432/jobautomater

# Redis (docker-compose)
REDIS_URL=redis://localhost:6379

# Object storage (docker-compose minio — dev substitute for R2)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=jobautomater
S3_REGION=us-east-1

# API (api/)
API_PORT=3001
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
APP_URL=http://localhost:3000
EMAIL_FROM=noreply@jobautomater.local
# Optional webhook that accepts {from,to,subject,text,html} JSON
SMTP_WEBHOOK_URL=
EMAIL_VERIFY_TTL=24h
PASSWORD_RESET_TTL=1h

# Web (web/)
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# Workers (workers/)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ATS-first apply (P4.3) — leave empty to fall back to Playwright
GREENHOUSE_JOB_BOARD_API_KEY=
LEVER_API_KEY=
SUBMIT_DRY_RUN=true

# Optional
SENTRY_DSN=
