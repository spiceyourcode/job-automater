# Staging environment template (P12.3)
# Copy to secrets store / host env — never commit real values.
# HG-1: no NEXT_PUBLIC_* secrets.

NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobautomater_staging
REDIS_URL=redis://HOST:6379
CELERY_BROKER_URL=redis://HOST:6379/0
CELERY_RESULT_BACKEND=redis://HOST:6379/1

JWT_SECRET=replace-with-32-plus-char-staging-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jobautomater-staging
S3_REGION=us-east-1

API_PORT=3001
APP_URL=https://staging.example.com
API_PUBLIC_URL=https://api.staging.example.com
EMAIL_FROM=noreply@staging.example.com
SMTP_WEBHOOK_URL=

NEXT_PUBLIC_API_URL=https://api.staging.example.com
API_URL=https://api.staging.example.com

# LLM (workers) — never expose to the browser
OPENAI_API_KEY=
QROK_API_KEY=
GOOGLE_API_KEY=
CEREBRAS_API_KEY=

SENTRY_DSN=
FEATURE_AUTO_APPLY=false
SUBMIT_DRY_RUN=true
